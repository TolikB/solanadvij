APP_MODE=paper
APP_REVISION=replace_with_40_character_git_commit
TIME_ZONE=Europe/Kyiv
HELIUS_API_KEY=replace_me
JUPITER_API_KEY=replace_me
POSTGRES_DSN=postgresql+asyncpg://sniper:replace_app_password@postgres:5432/sniper
MIGRATION_POSTGRES_DSN=postgresql+asyncpg://sniper_admin:replace_admin_password@postgres:5432/sniper
POSTGRES_DB=sniper
POSTGRES_ADMIN_USER=sniper_admin
POSTGRES_ADMIN_PASSWORD=replace_admin_password
SNIPER_DB_USER=sniper
SNIPER_DB_PASSWORD=replace_app_password
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_ADMIN_CHAT_ID=123456
TELEGRAM={"enabled":true,"daily_report_time":"00:00","include_all_time_with_daily":false}
# Leave empty in normal operation. Overrides the whole chain block, e.g. to halt
# instead of recording an unrecoverable archive gap and resuming:
# CHAIN={"halt_on_unrecoverable_gap":true}
CHAIN=
# End of the frozen statistical window; generate the exact line with
# python scripts/freeze_statistical_protocol.py collection-env --collection-start ...
COLLECTION=
# Provider endpoints and plan limits (not part of the strategy hash), e.g.
# PROVIDERS={"jupiter_requests_per_second":3,"rpc_requests_per_second":4}
PROVIDERS=
TELEGRAM_ALLOWED_CHAT_IDS=[123456]
TELEGRAM_ALLOWED_USER_IDS=[123456]
STARTING_EQUITY_USD=500
BASE_QUOTE_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
BASE_QUOTE_DECIMALS=6
JUPITER_REPLAY_MODE=false
REPLAY_SEED=
JUPITER_QUOTE_JOURNAL_PATH=./data/jupiter_quotes.ndjson
JUPITER_QUOTE_JOURNAL_RECORD=true
CONFIG_PATH=configs/default.yaml
HELIUS_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=replace_me
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=replace_me
BACKUP_RETENTION_DAYS=14
# Dead-man's switch for the monitor service (e.g. https://hc-ping.com/<uuid>);
# pinged after every passing 10-minute window. Leave empty to disable.
MONITOR_HEARTBEAT_URL=
# Off-host encrypted copies (docker compose --profile offsite up -d offsite).
# The password is rclone-obscured: docker run --rm rclone/rclone:1.68 obscure 'secret'
OFFSITE_S3_PROVIDER=Other
OFFSITE_S3_ENDPOINT=
OFFSITE_S3_REGION=
OFFSITE_S3_BUCKET=
OFFSITE_S3_ACCESS_KEY_ID=
OFFSITE_S3_SECRET_ACCESS_KEY=
OFFSITE_CRYPT_PASSWORD_OBSCURED=
OFFSITE_INTERVAL_SECONDS=21600
